{
  "id": "guition-jc4827w543",
  "name": "Guition JC4827W543 (4.3\" 480x272)",
  "projects": [
    {
      "id": "powerdashboard",
      "name": "PowerDashboard",
      "description": {
        "de": "ESP-IDF Firmware für Shelly-Plug-Leistungsdaten auf dem Guition Display.",
        "en": "ESP-IDF firmware for Shelly Plug power data on the Guition display."
      },
      "chipFamily": "ESP32-S3",
      "source": {
        "type": "github-release",
        "owner": "tome9111991",
        "repo": "ESP32-S3_Project",
        "projectPath": "Guition_JC4827W543/ESP-IDF/PowerDashboard",
        "tagPrefix": "PowerDashboard-",
        "assetTemplate": "PowerDashboard-Guition-JC4827W543.bin",
        "defaultLang": "FW"
      }
    },
    {
      "id": "kcwp",
      "name": "Klipper Crypto Weather Panel",
      "description": {
        "de": "Arduino-Variante für das Guition Board. Trage deine Werte ein, dann wird daraus eine personalisierte Firmware gebaut.",
        "en": "Arduino variant for the Guition board. Fill in your values and a personalised firmware will be built for you."
      },
      "chipFamily": "ESP32-S3",
      "source": {
        "type": "build-on-demand",
        "owner": "tome9111991",
        "repo": "ESP32-S3_Project",
        "projectPath": "Guition_JC4827W543/KlipperCryptoWeatherPanel",
        "workerUrl": "https://kcwp-flasher.tommi91.workers.dev",
        "turnstileSiteKey": "0x4AAAAAADP5q4gyHbYdhLhr",
        "workflow": "build-guition-klippercrypto.yml",
        "headerName": "config_private.h",
        "preamble": "#pragma once\n\n// Generiert vom ESP32 Web Flasher\n\n",
        "groups": [
          {
            "label": { "de": "WLAN", "en": "Wi-Fi" },
            "fields": [
              {
                "key": "WIFI_SSID",
                "label": { "de": "WLAN-Name (SSID)", "en": "Wi-Fi name (SSID)" },
                "type": "string",
                "default": "",
                "required": true
              },
              {
                "key": "WIFI_PASSWORD",
                "label": { "de": "WLAN-Passwort", "en": "Wi-Fi password" },
                "type": "password",
                "default": "",
                "required": true
              }
            ]
          },
          {
            "label": { "de": "Anzeige", "en": "Display" },
            "fields": [
              {
                "key": "UI_LANGUAGE",
                "label": { "de": "Display-Sprache", "en": "Display language" },
                "type": "select",
                "default": "UI_LANGUAGE_DE",
                "rawValue": true,
                "options": [
                  {
                    "value": "UI_LANGUAGE_DE",
                    "label": { "de": "Deutsch", "en": "German" }
                  },
                  {
                    "value": "UI_LANGUAGE_EN",
                    "label": { "de": "Englisch", "en": "English" }
                  }
                ],
                "hint": {
                  "de": "Legt die Sprache der Firmware-GUI zur Compile-Zeit fest.",
                  "en": "Sets the firmware UI language at compile time."
                }
              },
              {
                "key": "DATE_FORMAT",
                "label": { "de": "Datumsformat", "en": "Date format" },
                "type": "select",
                "default": "DATE_FORMAT_DMY_DOT",
                "rawValue": true,
                "options": [
                  { "value": "DATE_FORMAT_DMY_DOT", "label": { "de": "TT.MM.JJJJ (09.11.2026)", "en": "DD.MM.YYYY (09.11.2026)" } },
                  { "value": "DATE_FORMAT_DMY_SLASH", "label": { "de": "TT/MM/JJJJ (09/11/2026)", "en": "DD/MM/YYYY (09/11/2026)" } },
                  { "value": "DATE_FORMAT_MDY_SLASH", "label": { "de": "MM/TT/JJJJ (11/09/2026, USA)", "en": "MM/DD/YYYY (11/09/2026, US)" } },
                  { "value": "DATE_FORMAT_YMD_ISO", "label": { "de": "JJJJ-MM-TT (2026-11-09, ISO)", "en": "YYYY-MM-DD (2026-11-09, ISO)" } }
                ]
              },
              {
                "key": "TIME_FORMAT_12H",
                "label": { "de": "12-Stunden-Uhr (AM/PM)", "en": "12-hour clock (AM/PM)" },
                "type": "boolean",
                "default": false,
                "hint": {
                  "de": "Aus = 24h (23:05). An = 12h (11:05 PM).",
                  "en": "Off = 24h (23:05). On = 12h (11:05 PM)."
                }
              },
              {
                "key": "TEMPERATURE_FAHRENHEIT",
                "label": { "de": "Wetter in °F", "en": "Weather in °F" },
                "type": "boolean",
                "default": false,
                "hint": {
                  "de": "Aus = °C. Klipper-Temperaturen bleiben immer °C.",
                  "en": "Off = °C. Klipper temperatures always stay in °C."
                }
              },
              {
                "key": "DISPLAY_ROTATION",
                "label": { "de": "Display um 180° drehen", "en": "Rotate display by 180°" },
                "type": "boolean",
                "default": false,
                "trueValue": 0,
                "falseValue": 2,
                "hint": {
                  "de": "Aus = Standardausrichtung. An = Bild um 180° gedreht.",
                  "en": "Off = default orientation. On = image rotated by 180°."
                }
              }
            ]
          },
          {
            "label": { "de": "Screens", "en": "Screens" },
            "hint": {
              "de": "Welche Screens sollen gebaut werden? Mindestens einer muss aktiv sein. Deaktivierte Screens werden gar nicht erst erzeugt und ihre API-Abfragen entfallen (entlastet das Board).",
              "en": "Which screens should be built? At least one must be active. Disabled screens are not generated and their API calls are skipped (less load on the board)."
            },
            "minChecked": 1,
            "fields": [
              {
                "key": "SCREEN_TIME_ENABLED",
                "label": { "de": "Uhr & Wetter", "en": "Clock & weather" },
                "type": "boolean",
                "default": true
              },
              {
                "key": "SCREEN_CRYPTO_PRICE_ENABLED",
                "label": { "de": "Crypto Preis (24H-Change)", "en": "Crypto price (24h change)" },
                "type": "boolean",
                "default": true
              },
              {
                "key": "SCREEN_CRYPTO_CHART_ENABLED",
                "label": { "de": "Crypto Chart (Candles)", "en": "Crypto chart (candles)" },
                "type": "boolean",
                "default": true
              },
              {
                "key": "SCREEN_KLIPPER_ENABLED",
                "label": { "de": "Klipper", "en": "Klipper" },
                "type": "boolean",
                "default": true
              }
            ]
          },
          {
            "label": { "de": "Standort & Zeit", "en": "Location & time" },
            "fields": [
              {
                "key": "LOCATION_SEARCH",
                "label": { "de": "Stadt suchen", "en": "Search city" },
                "type": "location-search",
                "virtual": true,
                "targets": {
                  "latitude": "LOCATION_LATITUDE",
                  "longitude": "LOCATION_LONGITUDE",
                  "timezone": "TIMEZONE_POSIX"
                },
                "hint": {
                  "de": "Füllt Breitengrad, Längengrad und Zeitzone automatisch aus (Suche über Open-Meteo).",
                  "en": "Fills in latitude, longitude and timezone automatically (search via Open-Meteo)."
                }
              },
              {
                "key": "LOCATION_LATITUDE",
                "label": { "de": "Breitengrad", "en": "Latitude" },
                "type": "float",
                "default": 52.0,
                "required": true,
                "hint": { "de": "z.B. 52.520 für Berlin", "en": "e.g. 52.520 for Berlin" }
              },
              {
                "key": "LOCATION_LONGITUDE",
                "label": { "de": "Längengrad", "en": "Longitude" },
                "type": "float",
                "default": 13.0,
                "required": true,
                "hint": { "de": "z.B. 13.405 für Berlin", "en": "e.g. 13.405 for Berlin" }
              },
              {
                "key": "TIMEZONE_POSIX",
                "label": { "de": "Zeitzone", "en": "Timezone" },
                "type": "timezone",
                "default": "CET-1CEST,M3.5.0,M10.5.0/3",
                "required": true,
                "hint": {
                  "de": "Wird mit der Zeitzone deines Browsers vorbelegt. Sommerzeit stellt das Display selbst um. Fortgeschrittene können auch direkt einen POSIX-String eintippen.",
                  "en": "Pre-filled with your browser's timezone. The display handles daylight saving time by itself. Advanced users can also type a POSIX string directly."
                }
              }
            ]
          },
          {
            "label": { "de": "Crypto", "en": "Crypto" },
            "fields": [
              {
                "key": "CRYPTO_BASE_SYMBOL",
                "label": { "de": "Basis-Symbol", "en": "Base symbol" },
                "type": "string",
                "default": "BTC"
              },
              {
                "key": "CRYPTO_QUOTE_SYMBOL",
                "label": { "de": "Quote-Symbol", "en": "Quote symbol" },
                "type": "string",
                "default": "USD",
                "hint": {
                  "de": "Chart-Kerzen gibt es nur für Coinbase-Exchange-Paare (z.B. USD, EUR, GBP, USDC, USDT). Andere Währungen zeigen evtl. nur den Preis.",
                  "en": "Chart candles only exist for Coinbase Exchange pairs (e.g. USD, EUR, GBP, USDC, USDT). Other currencies may only show the price."
                }
              },
              {
                "key": "CRYPTO_PRICE_PREFIX",
                "label": { "de": "Preis-Prefix", "en": "Price prefix" },
                "type": "string",
                "default": "",
                "hint": {
                  "de": "Leer = automatisch ($ für USD, sonst Quote-Symbol). Nur ASCII-Zeichen, € oder £ kann das Display nicht darstellen.",
                  "en": "Empty = automatic ($ for USD, otherwise quote symbol). ASCII only, the display cannot render € or £."
                }
              },
              {
                "key": "CRYPTO_SERVICE_NAME",
                "label": { "de": "Service-Label", "en": "Service label" },
                "type": "string",
                "default": "COINBASE",
                "hint": {
                  "de": "Nur Anzeige. Preis-API ist hardcoded Coinbase.",
                  "en": "Display only. Price API is hardcoded to Coinbase."
                }
              },
              {
                "key": "CRYPTO_CHART_TIMEFRAME",
                "label": { "de": "Chart-Timeframe", "en": "Chart timeframe" },
                "type": "select",
                "default": "1D",
                "options": ["15M", "1H", "6H", "1D"],
                "hint": {
                  "de": "Verfügbare Kerzen-Zeitfenster aus dem Sketch.",
                  "en": "Available candle timeframes from the sketch."
                }
              }
            ]
          },
          {
            "label": { "de": "Klipper", "en": "Klipper" },
            "fields": [
              {
                "key": "KLIPPER_BASE_URL",
                "label": { "de": "Klipper Base-URL", "en": "Klipper base URL" },
                "type": "string",
                "default": "http://mainsail",
                "required": true,
                "hint": {
                  "de": "z.B. http://mainsail.local oder http://192.168.x.x",
                  "en": "e.g. http://mainsail.local or http://192.168.x.x"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
